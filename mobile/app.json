{
  "expo": {
    "name": "HandicApp",
    "slug": "handicapp",
    "scheme": "handicapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9fafb",
      "dark": {
        "image": "./assets/splash-logo.png",
        "backgroundColor": "#0b0b0c"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.handicapp.app",
      "associatedDomains": [
        "applinks:app.handicapp.com.ar"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "HandicApp necesita acceso a la cámara para sacar fotos de los caballos y las tareas.",
        "NSPhotoLibraryUsageDescription": "HandicApp necesita acceso a tu galería para subir fotos de caballos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.handicapp.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9D6C35"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.handicapp.com.ar",
              "pathPrefix": "/invitacion"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "HandicApp necesita acceso a tu galería para subir fotos de caballos.",
          "cameraPermission": "HandicApp necesita acceso a la cámara para sacar fotos de los caballos y las tareas."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HandicApp necesita acceso a la cámara para sacar fotos de los caballos y las tareas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0f1f3d",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "100113bd-7d35-49a8-90c9-0b93f5bc49aa"
      }
    },
    "owner": "alejomaros",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/100113bd-7d35-49a8-90c9-0b93f5bc49aa"
    }
  }
}
