{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.0.58:3001/api"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.handicapp.com.ar/api",
        "EXPO_PUBLIC_APP_URL": "https://app.handicapp.com.ar"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.handicapp.com.ar/api",
        "EXPO_PUBLIC_APP_URL": "https://app.handicapp.com.ar"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
